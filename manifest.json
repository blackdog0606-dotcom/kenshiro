{
  "manifestVersion": 5,
  "id": "com.blackdog0606.kenshiro.blackcrop",
  "name": "Kenshiro 黒枠自動クロップ（最小版）",
  "version": "0.1.1",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "requiredPermissions": { "localFileSystem": "fullAccess" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "blackCropPanel",
      "label": { "default": "黒枠自動クロップ" },
      "minimumSize": { "width": 340, "height": 360 },
      "preferredDockedSize": { "width": 420, "height": 620 },
      "preferredFloatingSize": { "width": 500, "height": 680 }
    }
  ]
}
